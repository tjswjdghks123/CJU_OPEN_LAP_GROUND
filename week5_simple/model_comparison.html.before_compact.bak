ent.getElementById(id);const r=d.result;const pct=v=>v==null?'계산 불가':(v*100).toFixed(2)+'%';
$('summary').innerHTML=Object.entries(d.names).map(([k,n])=>{const a=r.old.by_kind[k],b=r.new.by_kind[k],positive=a.events>0;return `<tr><td>${n}</td><td>${positive?a.hits:a.false_alert_cases}/30</td><td>${positive?b.hits:b.false_alert_cases}/30</td><td>${positive?'사건 감지 ↑':'무사건 사례 경보 ↓'}</td></tr>`}).join('');
$('overall').textContent=`전체 양성 창 재현율: ${pct(r.old.windows.recall)} → ${pct(r.new.windows.recall)} / 경보 정밀도: ${pct(r.old.windows.precision)} → ${pct(r.new.windows.precision)} / 음성 창 오경보율: ${pct(r.old.windows.false_positive_rate)} → ${pct(r.new.windows.false_positive_rate)}`;
const ret=r.old_rethresholded;$('retuned').textContent=`기존 기준 ${r.old.threshold}, 개선 후보 기준 ${r.new.threshold}. 기존 가중치에 기준만 ${ret.threshold}로 바꾸면 기본 ${ret.by_kind.standard.hits}/30, 약한 ${ret.by_kind.weak.hits}/30, 느린 ${ret.by_kind.slow.hits}/30 감지. 음성 창 오경보율 ${pct(ret.windows.false_positive_rate)}. 개선 후보의 무사건 오경보와 함께 비교하세요.`;
for(const [k,n] of Object.entries(d.names))$('kind').add(new Option(n,k));$('kind').value='weak';
function seeds(){const cs=d.cases.filter(c=>c.kind===$('kind').value);$('seed').innerHTML='';for(const c of cs)$('seed').add(new Option(c.seed,c.seed));draw()}
function draw(){const c=d.cases.find(c=>c.seed===Number($('seed').value));$('case-note').textContent=`시드 ${c.seed} · 상승 진폭 ${(c.amplitude*100).toFixed(0)}% · 잡음 ${c.noise.toFixed(2)}배 · ${c.event==null?'가상 사건 없음':'가상 사건 '+c.event+'초, 상승 기간 '+c.duration+'초'}`;
const x=t=>55+t/179*920,y=s=>235-s*190;let svg='';for(const s of [0,.25,.5,.75,1])svg+=`<line x1="55" y1="${y(s)}" x2="975" y2="${y(s)}" stroke="#ddd"/><text x="8" y="${y(s)+4}">${s}</text>`;for(const t of [0,30,60,90,120,150,179])svg+=`<text x="${x(t)-8}" y="265">${t}</text>`;
if(c.event!=null)svg+=`<rect x="${x(c.event-10)}" y="40" width="${x(10)-x(0)}" height="195" fill="#ffe0b1"/><line x1="${x(c.event)}" x2="${x(c.event)}" y1="40" y2="235" stroke="#c33"/>`;
for(const [k,color] of [['old','#4777b8'],['new','#e98a3c']]){svg+=`<line x1="55" x2="975" y1="${y(r[k].threshold)}" y2="${y(r[k].threshold)}" stroke="${color}" stroke-dasharray="5 4"/><polyline points="${c[k].map((v,i)=>x(i+30)+','+y(v)).join(' ')}" fill="none" stroke="${color}" stroke-width="2.7"/>`}$('scores').innerHTML=svg;
const describe=k=>{const m=r[k].cases.find(s=>s.seed===c.seed);return c.event==null?`경보 ${m.alert_windows}개 창`:m.hit?`감지 · ${m.lead}초 선행`:'누락'};$('outcome').textContent=`기존: ${describe('old')} / 개선 후보: ${describe('new')}`;
let input='';const max=Math.max(3,...c.inputs.flat())*1.1,iy=v=>210-v/max*170;for(let j=0;j<3;j++)input+=`<polyline points="${c.inputs.map((v,t)=>x(t)+','+iy(v[j])).join(' ')}" fill="none" stroke="${['#4777b8','#8759ae','#23956c'][j]}" stroke-width="2"/>`;for(const t of [0,30,60,90,120,150,179])input+=`<text x="${x(t)-8}" y="245">${t}</text>`;for(const v of [0,1,2,3])input+=`<text x="10" y="${iy(v)}">${v}</text>`;$('inputs').innerHTML=input;}
$('kind').onchange=seeds;$('seed').onchange=draw;seeds();</script></html>